          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(rate(v2ray_traffic_uplink_bytes_total{dimension=\"inbound\"}[2m])) * 8 / 1000000",
